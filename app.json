{
  "expo": {
    "name": "BabyOi",
    "slug": "BabyOi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo1.png",
    "scheme": "babyoi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duongdang2526.BabyOi",
      "infoPlist": {
        "NSCameraUsageDescription": "BabyOi cần quyền truy cập camera để chụp ảnh hồ sơ, ảnh nhật ký và ảnh nguyên liệu khi mẹ chủ động dùng các tính năng này.",
        "NSPhotoLibraryUsageDescription": "BabyOi cần quyền truy cập thư viện ảnh để mẹ chọn ảnh hồ sơ, ảnh nhật ký và ảnh nguyên liệu khi mẹ chủ động dùng các tính năng này.",
        "NSPhotoLibraryAddUsageDescription": "BabyOi có thể cần lưu ảnh do mẹ tạo hoặc chỉnh sửa vào thư viện ảnh khi mẹ chủ động yêu cầu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF9F3",
        "foregroundImage": "./assets/images/logo1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.duongdang2526.BabyOi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo2.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FEF9F3",
          "dark": {
            "backgroundColor": "#FEF9F3"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BabyOi cần quyền truy cập thư viện ảnh để mẹ chọn ảnh hồ sơ, ảnh nhật ký và ảnh nguyên liệu khi mẹ chủ động dùng các tính năng này.",
          "cameraPermission": "BabyOi cần quyền truy cập camera để chụp ảnh hồ sơ, ảnh nhật ký và ảnh nguyên liệu khi mẹ chủ động dùng các tính năng này."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "795446588674-54v3f5u19t9tii8hu5vp9763i78g8dpd.apps.googleusercontent.com",
      "googleAndroidClientId": "795446588674-54v3f5u19t9tii8hu5vp9763i78g8dpd.apps.googleusercontent.com",
      "googleIosClientId": "795446588674-55cfglrm1lf78s46j09ghhif31lu5ni5.apps.googleusercontent.com",
      "eas": {
        "projectId": "76d67dab-c4c6-4c89-8404-49bfec9a91d7"
      }
    }
  }
}
